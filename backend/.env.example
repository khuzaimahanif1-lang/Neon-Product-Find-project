# Copy to .env. Public marketplace adapters are enabled by default.
NEONFIND_ENVIRONMENT=development
NEONFIND_CATALOG_MODE=live
NEONFIND_PUBLIC_MARKETPLACES=["daraz","amazon","alibaba","aliexpress"]
NEONFIND_MARKETPLACE_LIMIT=24
NEONFIND_FETCH_EXCHANGE_RATES=true
NEONFIND_SEARCH_CURRENCY=PKR
# Base-currency units per foreign unit. Optional when exchange fetching is disabled.
# NEONFIND_CURRENCY_RATES={"PKR":1}
NEONFIND_PORT=8001
NEONFIND_CACHE_TTL_SECONDS=60
NEONFIND_PROVIDER_TIMEOUT_SECONDS=20
NEONFIND_SESSION_MINUTES=60
# Set a random secret of at least 32 characters for production.
# In development a random signing key is persisted in backend/data/.jwt-secret.
# NEONFIND_JWT_SECRET=
# NEONFIND_DATABASE_URL=sqlite+aiosqlite:///C:/absolute/path/neonfind.db
# NEONFIND_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8001","http://127.0.0.1:8001"]
# Enabled providers.json adapters replace the corresponding public-page adapter.
# Set catalog mode to demo explicitly to use development fixtures after a search.
# NEONFIND_PROVIDER_CONFIG=providers.json

# Individual public Shopify storefronts; confirm each store's displayed currency.
NEONFIND_SHOPIFY_STORES=[{"name":"Audionic","url":"https://audionic.co","currency":"PKR","product_card_selector":".product-item","sales_badge_selector":".feature-badge"}]
# Example (replace with real stores):
# NEONFIND_SHOPIFY_STORES=[{"name":"My store","url":"https://your-store.myshopify.com","currency":"USD"}]

# Use NEONFIND_SHOPIFY_STORES=[] to disable Shopify storefronts.
